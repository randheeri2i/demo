{
  "name": "demo/laravel-excel-compare",
  "description": "Laravel application to compare two Excel files with preview and downloads",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "laravel/tinker": "^2.10",
    "phpoffice/phpspreadsheet": "^2.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  }
}
